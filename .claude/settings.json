{
  "hooks": {
    "PostToolUse": [
      {
        "matcher": "Edit|Write",
        "hooks": [
          {
            "type": "command",
            "command": "node .claude/hooks/oxlint-on-edit.js",
            "timeout": 30,
            "statusMessage": "oxlint..."
          }
        ]
      }
    ],
    "PreToolUse": [
      {
        "matcher": "Edit|Write",
        "hooks": [
          {
            "type": "command",
            "command": "node .claude/hooks/block-secret-edit.js",
            "timeout": 10
          }
        ]
      }
    ]
  }
}
